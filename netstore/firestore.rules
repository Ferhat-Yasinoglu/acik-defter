/* ==========================================================================
   NetStore — Firestore güvenlik kuralları (şablon)

   Firebase konsolunda: Firestore Database > Rules > yapıştır > Publish

   Bu dosya bir ŞABLONDUR. Yürürlükteki gerçek kurallar Firebase konsolunda
   durur ve izinli hesapların adreslerini içerir. Bu depo herkese açık
   olduğu için adresler buraya yazılmaz: kimin girebildiğini ilan etmek,
   saldırgana hangi hesapları hedefleyeceğini söylemek olurdu.

   Hesap eklemek / çıkarmak: konsoldaki Rules metnini düzenleyip Publish
   deyin. Uygulama tarafında yapılacak bir şey yoktur — istemci artık kendi
   listesini tutmaz, kararı sunucudan gelen yanıta bakarak verir.

   Yetkisiz bir hesap girdiğinde Firestore “permission-denied” döner ve
   uygulama “bu hesabın erişimi yok” ekranını gösterir.
   ========================================================================== */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function izinli() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             /* Gerçek adresler yalnızca konsoldaki kopyada — küçük harfle. */
             'birinci@gmail.com',
             'ikinci@gmail.com'
           ];
    }

    /* Ortak defter: ürünler, müşteriler, personel, satışlar, tahsilatlar,
       alışlar. İzinli hesaplar tam yetkilidir. */
    match /shops/{shopId}/{belge=**} {
      allow read, write: if izinli();
    }

    /* Başka hiçbir yola erişim yok. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
