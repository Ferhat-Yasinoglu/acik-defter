{
  "id": "./",
  "name": "NetStore — Dükkan Yönetimi",
  "short_name": "NetStore",
  "description": "Stok, satış, müşteri, borç ve tahsilat yönetim paneli. Dari / Türkçe / English.",
  "start_url": "./index.html#/dashboard",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0B1120",
  "theme_color": "#0B1120",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png",     "sizes": "192x192",   "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png",     "sizes": "512x512",   "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512",   "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-1024.png",    "sizes": "1024x1024", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Yeni Satış",  "url": "./index.html#/satislar",   "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Müşteriler",  "url": "./index.html#/musteriler", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Borç Takibi", "url": "./index.html#/borc",       "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
