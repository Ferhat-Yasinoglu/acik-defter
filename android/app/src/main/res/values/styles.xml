<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    LauncherActivity yalnizca acilis gorselini gosterip Chrome'a devrediyor,
    bu yuzden pencere saydam. Parent'in AppCompat olmasi sart: kitapligin
    etkinligi AppCompat tabanliysa baska bir temayla acilista cokerdi ve bu
    derlemede degil, ancak telefonda ortaya cikardi.
  -->
  <style name="Theme.Launcher" parent="Theme.AppCompat.NoActionBar">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:backgroundDimEnabled">false</item>
  </style>
</resources>
